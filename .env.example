# Q-Learn Mobile — public client configuration.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app binary: NEVER put
# secrets here (no Supabase service key, LLM keys, DB URLs, Vercel tokens).
# Copy to .env.local for local development.

# FastAPI backend (same deployment the web app uses). On a physical device or
# Android emulator use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Same Supabase project as the web app (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Curriculum source, mirrors the web's NEXT_PUBLIC_CONTENT_SOURCE (Phase 2).
# legacy = FastAPI /api/v1/courses · cms = {EXPO_PUBLIC_CONTENT_URL}/api/cms/*
EXPO_PUBLIC_CONTENT_SOURCE=legacy
EXPO_PUBLIC_CONTENT_URL=http://localhost:3000
